    {
      "datasource": "GMP (Prometheus)",
      "description": "24-hour Cloud Run availability for osv-grpc-v1. Click to open Dashboard 1 (Executive Overview & SLAs).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2,
          "links": [
            {
              "targetBlank": false,
              "title": "Open 1. Executive Overview & SLAs",
              "url": "/d/osv-exec-overview"
            }
          ],
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 99.5
              },
              {
                "color": "green",
                "value": 99.95
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 14
      },
      "id": 10,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "7.5.52",
      "targets": [
        {
          "expr": "(1 - (sum(rate(run_googleapis_com:request_count{service_name=\"osv-grpc-v1\",response_code_class=\"5xx\", monitored_resource=\"cloud_run_revision\"}[24h])) / sum(rate(run_googleapis_com:request_count{service_name=\"osv-grpc-v1\", monitored_resource=\"cloud_run_revision\"}[24h])))) * 100",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "1. Public API Availability (24h)",
      "type": "stat"
    },
    {
      "datasource": "GMP (Prometheus)",
      "description": "Undelivered Pub/Sub messages waiting in the primary worker subscription. Click to open Dashboard 2 (Ingestion & Worker Pipeline Operations).",
