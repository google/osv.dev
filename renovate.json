{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Australia/Sydney",
  "schedule": [
    "before 6am on wednesday"
  ],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 20,
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "labels": [
    "dependencies"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on wednesday"
    ]
  },
  "git-submodules": {
    "enabled": true
  },
  "pip_requirements": {
    "ignorePaths": [
      "docker/poetry/requirements.txt"
    ]
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": true
    },
    {
      "matchPackageNames": ["redis"],
      "matchCategories": ["python"],
      "allowedVersions": "< 7.0.0"
    },
    {
      "matchPackageNames": ["protobuf"],
      "matchCategories": ["python"],
      "allowedVersions": "< 7.0.0"
    },
    {
      "matchDepNames": [
        "gcp/workers/oss_fuzz_worker/osv-test"
      ],
      "enabled": false
    },
    {
      "matchDepTypes": ["uses-with"],
      "enabled": false
    },
    {
      "matchFileNames": [
        "website/**"
      ],
      "groupName": "website"
    },
    {
      "matchFileNames": [
        "gcp/functions/**",
        "gcp/workers/**"
      ],
      "matchCategories": ["python"],
      "groupName": "gcp-services-python"
    },
    {
      "matchFileNames": [
        "gcp/indexer/**"
      ],
      "matchCategories": ["golang"],
      "groupName": "gcp-indexer-go"
    },
    {
      "matchFileNames": [
        "vulnfeeds/**",
        "external/**"
      ],
      "matchCategories": ["golang"],
      "groupName": "vulnfeeds-go"
    },
    {
      "matchFileNames": [
        "docs/**"
      ],
      "groupName": "docs"
    },
    {
      "matchFileNames": [
        "tools/**"
      ],
      "matchCategories": [
        "python"
      ],
      "groupName": "tools-python"
    },
    {
      "matchFileNames": [
        "tools/**"
      ],
      "matchCategories": [
        "golang"
      ],
      "groupName": "tools-go"
    },
    {
      "matchFileNames": [
        "deployment/terraform/**"
      ],
      "groupName": "terraform"
    },
    {
      "matchFileNames": [
        ".github/**",
        "actions/**"
      ],
      "groupName": "workflows"
    },
    {
      "matchFileNames": [
        "pyproject.toml",
        "go/cmd/vanir_signatures/**"
      ],
      "matchCategories": [
        "python"
      ],
      "groupName": "osv-lib"
    },
    {
      "matchFileNames": [
        "bindings/**",
        "go/**",
        "tools/repo-allowlist-sync/**"
      ],
      "matchCategories": [
        "golang"
      ],
      "groupName": "go-libraries"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "python"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ruby"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchManagers": [
        "dockerfile"
      ],
      "groupName": "docker"
    },
    {
      "matchFileNames": [
        "docker/**"
      ],
      "groupName": "docker"
    },
    {
      "matchDatasources": [
        "golang-version"
      ],
      "rangeStrategy": "bump",
      "groupName": "golang-version"
    },
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "golang"
      ],
      "groupName": "golang-version"
    },
    {
      "matchManagers": [
        "git-submodules"
      ],
      "groupName": "osv-schema",
      "minimumReleaseAge": null
    },
    {
      "matchPackageNames": [
        "osv-schema",
        "osv/osv-schema",
        "ossf/osv-schema",
        "https://github.com/ossf/osv-schema",
        "https://github.com/ossf/osv-schema.git",
        "github.com/ossf/osv-schema/**"
      ],
      "groupName": "osv-schema",
      "minimumReleaseAge": null
    },
    {
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "matchManagers": [
        "poetry",
        "pip-compile"
      ],
      "groupName": "python",
      "commitMessageExtra": "(python)"
    },
    {
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "matchManagers": [
        "npm"
      ],
      "groupName": "npm",
      "commitMessageExtra": "(npm)"
    },
    {
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "matchManagers": [
        "bundler"
      ],
      "groupName": "bundler",
      "commitMessageExtra": "(bundler)"
    },
    {
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "matchManagers": [
        "terraform"
      ],
      "groupName": "terraform",
      "commitMessageExtra": "(terraform)"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "deployment/terraform/environments/oss-vdb/main.tf",
        "deployment/terraform/environments/oss-vdb-test/main.tf"
      ],
      "matchStrings": [
        "esp_version\\s*=\\s*\"(?<currentValue>.*)\""
      ],
      "depNameTemplate": "gcr.io/endpoints-release/endpoints-runtime-serverless",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "go/cmd/osv-linter-worker/Dockerfile"
      ],
      "matchStrings": [
        "git clone https://github\\.com/ossf/osv-schema\\.git.*checkout (?<currentDigest>[a-f0-9]{40})"
      ],
      "currentValueTemplate": "main",
      "depNameTemplate": "osv-schema",
      "packageNameTemplate": "https://github.com/ossf/osv-schema",
      "datasourceTemplate": "git-refs",
      "versioningTemplate": "git"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "osv/models.py"
      ],
      "matchStrings": [
        "SCHEMA_VERSION\\s*=\\s*'(?<currentValue>.*)'"
      ],
      "packageNameTemplate": "ossf/osv-schema",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    }
  ]
}
